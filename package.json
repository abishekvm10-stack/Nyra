{
  "name": "nyra-desktop",
  "version": "0.4.1",
  "description": "Nyra \u2014 compiles rough prompts into structured ones, system-wide, via clipboard + a global hotkey.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac --arm64"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.nyra.desktop",
    "productName": "Nyra",
    "files": [
      "**/*",
      "!README.md",
      "!BUILD-GUIDE.md",
      "!PROJECT-SPEC.md",
      "!MEMORY.md",
      "!tools/**",
      "!dist/**",
      "!release/**",
      "!backend/**",
      "!.github/**",
      "!package-lock.json"
    ],
    "asarUnpack": ["**/node_modules/@nut-tree-fork/**/*", "**/node_modules/@nut-tree/**/*"],
    "compression": "maximum",
    "electronLanguages": ["en-US"],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "files": [
        "**/*",
        "!README.md",
        "!BUILD-GUIDE.md",
        "!PROJECT-SPEC.md",
        "!MEMORY.md",
        "!tools/**",
        "!dist/**",
        "!release/**",
        "!backend/**",
        "!.github/**",
        "!package-lock.json",
        "!node_modules/@nut-tree-fork/libnut-darwin/**",
        "!node_modules/@nut-tree-fork/libnut-linux/**"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity",
      "artifactName": "Nyra-${version}-${arch}.${ext}",
      "sign": null,
      "files": [
        "**/*",
        "!README.md",
        "!BUILD-GUIDE.md",
        "!PROJECT-SPEC.md",
        "!MEMORY.md",
        "!tools/**",
        "!dist/**",
        "!release/**",
        "!backend/**",
        "!.github/**",
        "!package-lock.json",
        "!node_modules/@nut-tree-fork/libnut-win32/**",
        "!node_modules/@nut-tree-fork/libnut-linux/**"
      ]
    },
    "afterPack": "build/afterPackHook.js",
    "afterSign": "build/afterSignHook.js",
    "publish": {
      "provider": "github",
      "owner": "abishekvm10-stack",
      "repo": "Nyra",
      "releaseType": "release"
    }
  }
}
